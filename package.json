        "jimp": "1.6.0",
        "node-screenshots": "^0.2.1",
        "open": "^11.0.0",
        "ps-list": "^9.0.0",
        "ws": "^8.22.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
